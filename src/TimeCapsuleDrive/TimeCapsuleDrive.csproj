<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.4.0</Version>
    <Product>Time Capsule Drive</Product>
    <AssemblyTitle>Time Capsule Drive</AssemblyTitle>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The setup window is the only UI; keep WinForms names out of the rest of the code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official WinFsp installer is carried inside the program so that setup needs no internet. -->
    <EmbeddedResource Include="../../third_party/winfsp-*.msi" LogicalName="winfsp.msi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <!-- Compile against the WinFsp .NET library but do not ship it as a loose file: it is embedded below and
         written to disk by the program itself (see WinFspLibrary). -->
    <PackageReference Include="winfsp.net" Version="2.2.26323" ExcludeAssets="runtime" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- This build also runs on Windows 7 and 8. Its libraries are embedded (see Libraries in Compat.cs),
         so there is no .config file and nothing beside the program. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <EmbeddedResource Include="$(Pkgwinfsp_net)/lib/netstandard2.0/winfsp-msil.dll" LogicalName="winfsp-msil.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <EmbeddedResource Include="$(Pkgwinfsp_net)/lib/net35/winfsp-msil.dll" LogicalName="winfsp-msil.dll" />
  </ItemGroup>

  <Target Name="EmbedLibraries" AfterTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' == 'net48'">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" LogicalName="lib/%(ReferenceCopyLocalPaths.Filename).dll" />
    </ItemGroup>
  </Target>

</Project>
